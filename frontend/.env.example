# Copy to frontend/.env.local to change these. Never put secrets here: everything
# with the VITE_ prefix is built into the browser code.

# Backend the development server forwards /api calls to.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Port for the development server.
VITE_PORT=5173

# Used only by production builds (npm run build) served from a different origin than the
# API, e.g. https://api.example.com. The dev server always uses its proxy and ignores this.
VITE_API_BASE_URL=
