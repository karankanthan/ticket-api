GROQ_API_KEY=your_groq_api_key_here

# local (default) or production. production refuses to start without ADMIN_API_KEY.
APP_ENV=local

# Shared key for Helpdesk Head APIs. Optional locally; required in production.
# This is a single shared secret, not per-person login. Never commit a real value.
ADMIN_API_KEY=

# Ticket CSV and the folder for saved JSON data (approvals, batches, history).
# TICKETS_DATA_PATH=data/tickets_sample.csv
# APP_STORE_DIR=data/store

# Ticket SLA targets, in hours.
SLA_HOURS_URGENT=4
SLA_HOURS_HIGH=8
SLA_HOURS_NORMAL=24
SLA_HOURS_LOW=72

# Manager approval response targets, in hours.
APPROVAL_RESPONSE_HOURS_URGENT=4
APPROVAL_RESPONSE_HOURS_OTHER=24

# Pending approval reminders: hours after sending, and the maximum per request.
REMINDER_AFTER_HOURS=2,6,24
MAX_REMINDERS=3
