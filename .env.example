GROQ_API_KEY=your_groq_api_key_here

# local (default) or production. production refuses to start without ADMIN_API_KEY.
APP_ENV=local

# Shared key for Helpdesk Head APIs. Optional locally; required in production.
# This is a single shared secret, not per-person login. Never commit a real value.
ADMIN_API_KEY=

# Ticket CSV and the folder for saved JSON data (approvals, batches, history).
# TICKETS_DATA_PATH=data/tickets_sample.csv
# APP_STORE_DIR=data/store

# Ticket SLA targets, in hours.
SLA_HOURS_URGENT=4
SLA_HOURS_HIGH=8
SLA_HOURS_NORMAL=24
SLA_HOURS_LOW=72

# Manager approval response targets, in hours.
APPROVAL_RESPONSE_HOURS_URGENT=4
APPROVAL_RESPONSE_HOURS_OTHER=24

# Pending approval reminders: hours after sending, and the maximum per request.
REMINDER_AFTER_HOURS=2,6,24
MAX_REMINDERS=3

# Ticket SLA "at risk" when this fraction of the target time or less remains.
SLA_AT_RISK_FRACTION=0.25

# Largest batch the Helpdesk Head can send in one email.
MAX_BATCH_SIZE=100

# Address the manager's email links point to. Links to localhost only open on this computer.
# http://localhost:5173 opens the TicketFlow decision page (scripts/start-backend.ps1 uses it);
# http://localhost:8000 uses the API's built-in confirmation page.
PUBLIC_BASE_URL=http://localhost:8000
# Hours before an approve/reject/more-info link stops working. Reminders send fresh links.
ACTION_LINK_TTL_HOURS=72

# Background checks for reminders, overdue responses and SLA breaches.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300

# Email backend: file (saves .eml files, nothing is delivered), console (prints, nothing
# is delivered) or smtp (real delivery).
EMAIL_BACKEND=file
# EMAIL_OUTBOX_DIR=data/outbox
MANAGER_EMAIL=
MANAGER_NAME=
EMAIL_FROM=

# Needed only when EMAIL_BACKEND=smtp. SMTP_SECURITY is starttls (usually port 587),
# ssl (usually port 465) or none. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20
SMTP_MAX_ATTEMPTS=3
